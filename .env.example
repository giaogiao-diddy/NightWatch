# =====================================================
# NightWatch Environment Template
# 所有变量统一使用 NW_ 前缀（由 pydantic-settings 自动加载）
# =====================================================

# ------------------------------
# 基础应用配置
# ------------------------------
NW_APP_NAME=NightWatch
NW_ENVIRONMENT=dev
NW_LOG_LEVEL=INFO

# API 鉴权密钥（为空时本地开发模式可跳过鉴权）
NW_API_AUTH_KEY=

# 允许跨域来源（逗号分隔）
NW_API_CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# demo fallback 开关：true 时无真实连接器也可演示
NW_CONNECTORS_DEMO_FALLBACK=true

# SQLite 根目录（用于 checkpoint/runtime 状态）
NW_SQLITE_MOUNT_DIR=./runtime

# ------------------------------
# 调度系统连接器（Airflow 等）
# ------------------------------
NW_SCHEDULER_BACKEND=airflow
NW_SCHEDULER_BASE_URL=
NW_SCHEDULER_API_TOKEN=
NW_SCHEDULER_USERNAME=
NW_SCHEDULER_PASSWORD=
NW_SCHEDULER_TIMEOUT_SECONDS=10
NW_SCHEDULER_VERIFY_TLS=true

# ------------------------------
# Spark 连接器
# ------------------------------
NW_SPARK_HISTORY_BASE_URL=
NW_SPARK_YARN_RM_BASE_URL=
NW_SPARK_CONTROL_BASE_URL=
NW_SPARK_API_TOKEN=
NW_SPARK_TIMEOUT_SECONDS=15
NW_SPARK_VERIFY_TLS=true
NW_SPARK_LOG_MAX_BYTES=65536

# ------------------------------
# Flink 连接器
# ------------------------------
NW_FLINK_BASE_URL=
NW_FLINK_API_TOKEN=
NW_FLINK_TIMEOUT_SECONDS=10
NW_FLINK_VERIFY_TLS=true
NW_FLINK_POLL_INTERVAL_SECONDS=1
NW_FLINK_OPERATION_TIMEOUT_SECONDS=15

# ------------------------------
# LLM 推理配置（Instructor + OpenAI SDK）
# ------------------------------
NW_LLM_API_KEY=
NW_LLM_BASE_URL=https://api.openai.com/v1
NW_LLM_MODEL=gpt-4o-mini
NW_LLM_TIMEOUT_SECONDS=30
NW_LLM_MAX_RETRIES=2
NW_LLM_TEMPERATURE=0
NW_LLM_MAX_PROMPT_CHARS=12000

# ------------------------------
# 检索与向量库（Qdrant）
# ------------------------------
# 若填写 NW_QDRANT_URL，优先连接远程 Qdrant；
# 若为空，则回落到本地路径 NW_QDRANT_PATH。
NW_QDRANT_URL=
NW_QDRANT_API_KEY=
NW_QDRANT_TIMEOUT_SECONDS=10
NW_QDRANT_PATH=./qdrant_data

# ------------------------------
# LangGraph Checkpointer
# ------------------------------
# 可选: sqlite / none
NW_GRAPH_CHECKPOINTER_BACKEND=sqlite
NW_GRAPH_CHECKPOINTER_SQLITE_PATH=

# ------------------------------
# Worker 配置
# ------------------------------
NW_WORKER_ENABLE=true
NW_WORKER_POLL_INTERVAL_SECONDS=2
NW_WORKER_BATCH_SIZE=10
NW_WORKER_CLAIM_TTL_SECONDS=60
NW_WORKER_RETRY_BACKOFF_SECONDS=30
NW_WORKER_APPROVAL_RECHECK_SECONDS=120
NW_WORKER_MAX_ATTEMPTS=20
NW_WORKER_RUNTIME_SQLITE_PATH=

# ------------------------------
# FastMCP 服务配置
# ------------------------------
# role 可选: agent / oncall / admin
NW_MCP_ROLE=agent
# transport 可选: streamable-http / stdio
NW_MCP_TRANSPORT=streamable-http
NW_MCP_HOST=127.0.0.1
NW_MCP_PORT=9001

# ------------------------------
# Grafana 管理员配置（docker-compose 用）
# ------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-in-prod

# =====================================================
# 生产建议
# 1) 将所有密钥交给 Secret Manager 托管，不要写入代码仓库。
# 2) 关闭 NW_CONNECTORS_DEMO_FALLBACK。
# 3) 为 Scheduler/Spark/Flink/Qdrant 启用 TLS 并最小权限授权。
# =====================================================
